    <script>
        // ═══════════════════════════════════════════════════════════════════
        //  CITY WORK DASHBOARD — Full Screen + Clean UI + Working Auth
        // ═══════════════════════════════════════════════════════════════════

        (function() {
            'use strict';

            console.log('🚀 [CITY WORK] Starting...');

            // ─── READ SUPABASE CONFIG FROM config.js ──────────────────
            let SUPABASE_URL, SUPABASE_ANON_KEY;
            try {
                if (typeof design !== 'undefined' && design.supabase) {
                    SUPABASE_URL = design.supabase.url;
                    SUPABASE_ANON_KEY = design.supabase.anonKey;
                    console.log('✅ [CONFIG] Loaded from config.js');
                } else {
                    throw new Error('design.supabase not found');
                }
            } catch (e) {
                console.error('❌ [CONFIG] Failed to load Supabase config:', e);
                document.body.innerHTML = `
                        <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:#18202F;padding:20px;font-family:Plus Jakarta Sans,sans-serif;">
                            <div style="background:rgba(255,255,255,0.05);backdrop-filter:blur(16px);border-radius:40px;padding:40px;max-width:400px;text-align:center;border:1px solid rgba(255,255,255,0.1);">
                                <i class="fa-solid fa-triangle-exclamation" style="font-size:3rem;color:#B8734F;margin-bottom:12px;"></i>
                                <h2 style="font-size:20px;font-weight:700;color:#FAF7F2;">Configuration Error</h2>
                                <p style="color:rgba(250,247,242,0.7);margin-top:8px;font-size:14px;">Could not load Supabase credentials. Please check <code style="color:#B8734F;">config.js</code>.</p>
                                <a href="../index.html" style="display:inline-block;margin-top:20px;padding:12px 24px;background:#B8734F;color:#FAF7F2;border-radius:12px;text-decoration:none;font-weight:600;">Back to Login</a>
                            </div>
                        </div>
                    `;
                return;
            }

            // ─── DOM REFS ──────────────────────────────────────────────────
            const $ = id => document.getElementById(id);
            const statusBadge = $('statusBadge');
            const messageArea = $('messageArea');
            const userInfo = $('userInfo');
            const logoutBtn = $('logoutBtn');
            const searchInput = $('globalSearchInput');
            const sidebarToggle = $('sidebarToggle');
            const panelTitle = $('panelTitle');
            const syncIndicator = $('syncIndicator');

            // ─── SUPABASE CLIENT ──────────────────────────────────────────
            let supabase = null;
            try {
                if (typeof window.supabase !== 'undefined' && typeof window.supabase.createClient === 'function') {
                    supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
                    console.log('✅ [SUPABASE] Client created');
                } else {
                    console.warn('⚠️ [SUPABASE] Supabase library not loaded');
                }
            } catch (e) {
                console.warn('⚠️ [SUPABASE] Failed to create client:', e.message);
            }

            // ─── STATE ─────────────────────────────────────────────────────
            let userRole = 'user';
            let currentPanel = 'dashboard';

            // ─── HELPERS ──────────────────────────────────────────────────
            function setStatus(text, type) {
                statusBadge.className = 'status-badge-text text-[10px] sm:text-xs font-medium px-2 sm:px-3 py-0.5 sm:py-1 rounded-full border flex items-center gap-1 whitespace-nowrap';
                statusBadge.innerHTML = text;
                if (type === 'ok') statusBadge.classList.add('status-ok');
                else if (type === 'error') statusBadge.classList.add('status-error');
                else statusBadge.classList.add('status-waiting');
            }

            function showMessage(text, type) {
                const colors = {
                    info: 'bg-mist border-slate-200 text-midnight',
                    success: 'bg-mist border-slate-200 text-midnight',
                    error: 'bg-mist border-slate-200 text-midnight',
                    warning: 'bg-mist border-slate-200 text-midnight'
                };
                messageArea.innerHTML = `
                        <div class="rounded-xl border px-3 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm ${colors[type] || colors.info} flex items-center justify-between fade-in">
                            <span>${text}</span>
                            <button onclick="this.parentElement.remove()" class="text-slateblue hover:text-midnight ml-4">✕</button>
                        </div>
                    `;
            }

            function getRoleDisplay(role) {
                return role === 'admin' ? 'Admin' : 'User';
            }

            function updateSyncIndicator() {
                const now = new Date();
                const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                syncIndicator.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-1"></i>Synced ${timeStr}`;
            }

            // ─── ANIME.JS INTEGRATION ────────────────────────────────────
            function animatePanelIn(panel) {
                anime({
                    targets: panel,
                    opacity: [0, 1],
                    translateY: [10, 0],
                    duration: 400,
                    easing: 'easeOutCubic'
                });
            }

            function animateIconHover(element) {
                anime({
                    targets: element,
                    scale: [1, 1.2, 1],
                    duration: 400,
                    easing: 'easeOutElastic(1, .5)'
                });
            }

            function pulseStatusBadge() {
                anime({
                    targets: statusBadge,
                    scale: [1, 1.05, 1],
                    duration: 1000,
                    loop: true,
                    easing: 'easeInOutQuad'
                });
            }

            // ─── AUTH ──────────────────────────────────────────────────────
            async function checkSession() {
                if (!supabase) {
                    setStatus('⚠️ Auth disabled', 'error');
                    userInfo.textContent = 'ℹ️ Local mode – Supabase not available';
                    showMessage('Running in local mode – authentication is disabled.', 'warning');
                    return;
                }

                setStatus('<span class="spinner"></span> Connecting...', 'waiting');
                pulseStatusBadge(); // subtle pulse while connecting

                try {
                    const { data, error } = await supabase.auth.getSession();
                    if (error) throw error;
                    const session = data?.session;

                    if (!session || !session.user) {
                        setStatus('🔓 Not logged in', 'error');
                        userInfo.textContent = 'Please log in';
                        showMessage('You are not logged in. Redirecting...', 'warning');
                        localStorage.removeItem('citywork_user');
                        setTimeout(() => { window.location.href = '../index.html'; }, 1500);
                        return;
                    }

                    // ─── Valid session ─────────────────────────────────────
                    let role = 'user';
                    try {
                        const { data: profile, error: profileError } = await supabase
                            .from('profiles')
                            .select('role')
                            .eq('id', session.user.id)
                            .maybeSingle();

                        if (!profileError && profile?.role) {
                            role = profile.role;
                        } else if (!profile) {
                            await supabase.from('profiles').insert({
                                id: session.user.id,
                                email: session.user.email,
                                role: 'user'
                            });
                            console.log('✅ [AUTH] Created missing profile');
                        }
                    } catch (e) {
                        console.warn('⚠️ [AUTH] Profile fetch error:', e.message);
                    }

                    userRole = role;

                    localStorage.setItem('citywork_user', JSON.stringify({
                        id: session.user.id,
                        email: session.user.email,
                        role: role,
                        session: session
                    }));

                    const roleDisplay = getRoleDisplay(role);
                    setStatus(`✅ ${roleDisplay}`, 'ok');
                    userInfo.textContent = `Logged in as ${roleDisplay}`;

                    // Stop pulse animation after login
                    anime.remove(statusBadge);
                    updateSyncIndicator();

                    console.log('✅ [AUTH] Session valid – role:', role);

                } catch (err) {
                    console.error('❌ [AUTH] Error:', err.message);
                    setStatus('❌ Connection error', 'error');
                    showMessage('Failed to connect: ' + err.message + ' – click Retry', 'error');
                    anime.remove(statusBadge);
                }
            }

            // ─── LOGOUT ────────────────────────────────────────────────────
            async function logoutUser() {
                try {
                    if (supabase) await supabase.auth.signOut();
                } catch (_) {}
                localStorage.removeItem('citywork_user');
                window.location.href = '../index.html';
            }

            // ─── PANEL SWITCHING ──────────────────────────────────────────
            function showPanel(panelId) {
                currentPanel = panelId;
                document.querySelectorAll('.content-panel').forEach(panel => {
                    panel.classList.remove('active');
                });

                const target = document.getElementById('panel-' + panelId);
                if (target) {
                    target.classList.add('active');
                    animatePanelIn(target);
                }

                // Update sidebar active state
                document.querySelectorAll('.sidebar-item').forEach(item => {
                    item.classList.remove('active');
                });
                document.querySelectorAll('.sidebar-item').forEach(item => {
                    const onclickAttr = item.getAttribute('onclick');
                    if (onclickAttr && onclickAttr.includes("'" + panelId + "'")) {
                        item.classList.add('active');
                    }
                });

                // Update panel title in header
                const panelNames = {
                    dashboard: 'Dashboard',
                    masterlist: 'Masterlist',
                    chores: 'Daily Chores',
                    commercial: 'Commercial',
                    cps: 'CPS',
                    concert: 'Choice Concert Schedule',
                    weekly: 'Weekly Schedule',
                    classics: 'Classics'
                };
                panelTitle.textContent = panelNames[panelId] || panelId;
            }

            // ─── SIDEBAR TOGGLE (desktop only) ──────────────────────────
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                sidebar.classList.toggle('sidebar-collapsed');
                // Optional: animate sidebar width with anime.js
                if (sidebar.classList.contains('sidebar-collapsed')) {
                    anime({
                        targets: sidebar,
                        minWidth: [200, 60],
                        maxWidth: [200, 60],
                        duration: 300,
                        easing: 'easeOutCubic'
                    });
                } else {
                    anime({
                        targets: sidebar,
                        minWidth: [60, 200],
                        maxWidth: [60, 200],
                        duration: 300,
                        easing: 'easeOutCubic'
                    });
                }
            }

            // ─── GLOBAL SEARCH ────────────────────────────────────────────
            const searchableItems = [];

            function buildSearchIndex() {
                document.querySelectorAll('#sidebarNav .sidebar-item').forEach(item => {
                    const text = item.getAttribute('data-search') || item.textContent.trim();
                    const label = item.querySelector('.label')?.textContent || text;
                    searchableItems.push({
                        element: item,
                        type: 'sidebar',
                        text: label,
                        searchData: text,
                        panel: item.getAttribute('data-panel') || null
                    });
                });

                document.querySelectorAll('.archive-card').forEach(card => {
                    const title = card.querySelector('h3')?.textContent || '';
                    const desc = card.querySelector('p')?.textContent || '';
                    const searchData = card.dataset.search || title + ' ' + desc;
                    const panel = card.closest('.content-panel');
                    const panelId = panel?.dataset.panel || null;
                    searchableItems.push({
                        element: card,
                        type: 'card',
                        text: title + ' ' + desc,
                        searchData: searchData,
                        panel: panelId,
                        title: title
                    });
                });
            }

            function highlightText(text, query) {
                if (!query || !text) return text;
                const regex = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
                return text.replace(regex, '<span class="search-highlight">$1</span>');
            }

            function handleGlobalSearch(query) {
                const q = query.trim().toLowerCase();
                const hasQuery = q.length > 0;

                const searchClear = document.getElementById('searchClear');
                const resultsCount = document.getElementById('searchResultsCount');

                if (hasQuery) {
                    searchClear.classList.add('visible');
                } else {
                    searchClear.classList.remove('visible');
                }

                resetSearch();

                if (!hasQuery) {
                    resultsCount.classList.add('hidden');
                    return;
                }

                const matches = [];
                searchableItems.forEach(item => {
                    const searchStr = (item.searchData + ' ' + item.text).toLowerCase();
                    if (searchStr.includes(q)) {
                        matches.push(item);
                    }
                });

                if (matches.length > 0) {
                    resultsCount.textContent = matches.length;
                    resultsCount.classList.remove('hidden');
                } else {
                    resultsCount.textContent = '0';
                    resultsCount.classList.remove('hidden');
                }

                if (matches.length === 0) {
                    document.querySelectorAll('.archive-card').forEach(c => c.classList.add('search-hidden'));
                    return;
                }

                const panels = new Set(matches.map(m => m.panel).filter(p => p !== null));

                if (panels.size === 1 && panels.has('masterlist')) {
                    showPanel('masterlist');
                } else if (panels.size === 1 && panels.has('dashboard')) {
                    showPanel('dashboard');
                } else if (panels.size === 1) {
                    const panelId = panels.values().next().value;
                    if (panelId) showPanel(panelId);
                } else if (panels.size > 1) {
                    if (panels.has('masterlist')) showPanel('masterlist');
                    else showPanel(panels.values().next().value);
                }

                document.querySelectorAll('.archive-card').forEach(card => {
                    const cardTitle = card.querySelector('h3')?.textContent || '';
                    const cardDesc = card.querySelector('p')?.textContent || '';
                    const searchStr = (card.dataset.search || cardTitle + ' ' + cardDesc).toLowerCase();
                    if (searchStr.includes(q)) {
                        card.classList.remove('search-hidden');
                        const titleEl = card.querySelector('h3');
                        if (titleEl) {
                            const originalText = titleEl.textContent;
                            titleEl.innerHTML = highlightText(originalText, q);
                        }
                    } else {
                        card.classList.add('search-hidden');
                    }
                });

                document.querySelectorAll('#sidebarNav .sidebar-item').forEach(item => {
                    const searchData = item.getAttribute('data-search') || '';
                    const label = item.querySelector('.label')?.textContent || '';
                    const searchStr = (searchData + ' ' + label).toLowerCase();
                    if (searchStr.includes(q)) {
                        item.style.color = '#B8734F';
                    } else {
                        item.style.color = '';
                    }
                });
            }

            function resetSearch() {
                document.querySelectorAll('.archive-card').forEach(card => {
                    card.classList.remove('search-hidden');
                    const titleEl = card.querySelector('h3');
                    if (titleEl) {
                        const originalText = titleEl.textContent;
                        titleEl.innerHTML = originalText;
                    }
                });

                document.querySelectorAll('#sidebarNav .sidebar-item').forEach(item => {
                    item.style.color = '';
                });

                const resultsCount = document.getElementById('searchResultsCount');
                resultsCount.classList.add('hidden');
            }

            function clearSearch() {
                const searchInput = document.getElementById('globalSearchInput');
                const searchClear = document.getElementById('searchClear');
                const resultsCount = document.getElementById('searchResultsCount');
                searchInput.value = '';
                searchClear.classList.remove('visible');
                resultsCount.classList.add('hidden');
                resetSearch();
                searchInput.focus();
            }

            // ─── KEYBOARD SHORTCUTS ──────────────────────────────────────
            document.addEventListener('keydown', function(e) {
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    if (searchInput) { searchInput.focus();
                        searchInput.select(); }
                }
                if (e.key === 'Escape') {
                    if (searchInput) searchInput.blur();
                }

                // Alt+1..8 for panels
                if (e.altKey) {
                    const panelMap = {
                        '1': 'dashboard',
                        '2': 'masterlist',
                        '3': 'chores',
                        '4': 'commercial',
                        '5': 'cps',
                        '6': 'concert',
                        '7': 'weekly',
                        '8': 'classics'
                    };
                    const key = e.key;
                    if (panelMap[key]) {
                        e.preventDefault();
                        showPanel(panelMap[key]);
                    }
                }
            });

            // ─── ANIME.JS HOVER EFFECTS ─────────────────────────────────
            document.querySelectorAll('.sidebar-item').forEach(item => {
                item.addEventListener('mouseenter', function() {
                    const icon = this.querySelector('.icon');
                    if (icon) animateIconHover(icon);
                });
            });

            document.querySelectorAll('.archive-card').forEach(card => {
                card.addEventListener('mouseenter', function() {
                    const arrow = this.querySelector('.fa-arrow-right');
                    if (arrow) {
                        anime({
                            targets: arrow,
                            translateX: [0, 5],
                            duration: 300,
                            easing: 'easeOutQuad'
                        });
                    }
                });
                card.addEventListener('mouseleave', function() {
                    const arrow = this.querySelector('.fa-arrow-right');
                    if (arrow) {
                        anime({
                            targets: arrow,
                            translateX: [5, 0],
                            duration: 300,
                            easing: 'easeOutQuad'
                        });
                    }
                });
            });

            // ─── INIT ────────────────────────────────────────────────────
            document.addEventListener('DOMContentLoaded', function() {
                console.log('📄 [DOM] Ready – initializing...');

                logoutBtn.addEventListener('click', logoutUser);
                sidebarToggle.addEventListener('click', toggleSidebar);
                buildSearchIndex();

                // Update sync indicator every minute
                updateSyncIndicator();
                setInterval(updateSyncIndicator, 60000);

                // Set initial panel title
                showPanel('dashboard');

                // Animate welcome icon on load
                const welcomeIcon = document.querySelector('.welcome-icon');
                if (welcomeIcon) {
                    anime({
                        targets: welcomeIcon,
                        scale: [0.5, 1],
                        opacity: [0, 1],
                        duration: 800,
                        easing: 'easeOutElastic(1, .5)'
                    });
                }

                setTimeout(() => {
                    checkSession();
                }, 100);

                console.log('✅ [INIT] City Work Dashboard ready (with all improvements)');
            });

            // Expose functions globally
            window.showPanel = showPanel;
            window.handleGlobalSearch = handleGlobalSearch;
            window.clearSearch = clearSearch;
            window.toggleSidebar = toggleSidebar;

        })();
    </script>

</body>
</html>
